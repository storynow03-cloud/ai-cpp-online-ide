# ==========================================
# C++ 線上 IDE 環境變數範本 (.env.example)
# 請複製本檔案為 .env 並填入實際值（.env 已被 .gitignore 排除）
# 🛡️ 嚴禁在程式碼中寫死任何金鑰或敏感資訊
# ==========================================

# 應用程式執行環境 (development / production)
NODE_ENV=development
PORT=3000

# 服務端與 API 設定
API_BASE_URL=http://localhost:3000/api
CORS_ORIGIN=http://localhost:3000

# C++ 編譯與沙盒執行限制
SANDBOX_TIMEOUT_MS=5000
SANDBOX_MAX_MEMORY_MB=256
SANDBOX_MAX_OUTPUT_BYTES=65536
COMPILER_PATH=g++

# 資料庫 / 儲存（若有整合 Supabase 或其他後端服務）
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=your-anon-key-here
# ⚠️ 注意：服務金鑰 (SERVICE_ROLE_KEY) 僅限後端使用，絕對不可暴露於前端
# SUPABASE_SERVICE_ROLE_KEY=your-service-role-key-here
