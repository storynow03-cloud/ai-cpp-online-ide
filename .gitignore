# ==========================================
# 🛡️ 資安與機密檔案排除 (Security First)
# ==========================================
.env
.env.*
!.env.example
*.pem
*.key
*.cert
*.pfx
secrets/
credentials.json

# ==========================================
# 系統與編輯器設定
# ==========================================
.DS_Store
Thumbs.db
desktop.ini
.vscode/
!.vscode/settings.json
!.vscode/extensions.json
.idea/
*.swp
*.swo
*~

# ==========================================
# Node.js / 前端產物
# ==========================================
node_modules/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
.pnpm-store/
dist/
out/
.next/
build/
.cache/
.turbo/

# ==========================================
# Python / uv 隔離環境 (絕不污染系統)
# ==========================================
.venv/
__pycache__/
*.py[cod]
*$py.class
*.so
.pytest_cache/
.ruff_cache/
.mypy_cache/

# ==========================================
# C / C++ 編譯輸出與執行產物
# ==========================================
*.o
*.obj
*.exe
*.dll
*.so
*.dylib
*.a
*.lib
bin/
obj/
cmake-build-*/
build/
CMakeCache.txt
CMakeFiles/

# ==========================================
# 沙盒與暫存執行檔 (C++ 線上執行隔離區)
# ==========================================
temp/
sandbox_workdir/
runner_tmp/
*.log
